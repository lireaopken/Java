-- =========================================================
-- Crowdfunding Platform Database (PostgreSQL)
-- Based on your ERD: Users, Projects, Categories, Rewards,
-- Donations, Payment_methods, Comments
-- =========================================================

-- Optional: keep everything in a dedicated schema
-- CREATE SCHEMA crowdfunding;
-- SET search_path TO crowdfunding;

-- ---------------------------
-- 1) USERS
-- Purpose: stores platform accounts (creators + donors).
-- Key design:
--  - users_id is the Primary Key (unique identifier).
--  - email is UNIQUE and NOT NULL to prevent duplicate accounts.
--  - password_hash should store a hash, not plaintext.
-- ---------------------------
CREATE TABLE users (
    users_id        BIGINT GENERATED ALWAYS AS IDENTITY PRIMARY KEY,
    email           VARCHAR(50) NOT NULL UNIQUE,
    phone_number    VARCHAR(50),
    users_name      VARCHAR(50) NOT NULL,
    password_hash   VARCHAR(255) NOT NULL,
    created_at      TIMESTAMP NOT NULL DEFAULT NOW()
);

COMMENT ON TABLE users IS 'Accounts for donors/creators. Email unique. Stores hashed password and basic contact info.';
COMMENT ON COLUMN users.users_id IS 'Primary key. Surrogate unique identifier for each user.';
COMMENT ON COLUMN users.email IS 'Unique login identifier. NOT NULL + UNIQUE ensures no duplicates.';
COMMENT ON COLUMN users.phone_number IS 'Optional contact phone.';
COMMENT ON COLUMN users.users_name IS 'Displayed name. Required.';
COMMENT ON COLUMN users.password_hash IS 'Hashed password (never store plaintext). Using VARCHAR(255) for modern hash formats.';
COMMENT ON COLUMN users.created_at IS 'Account creation timestamp (default NOW()).';


-- ---------------------------
-- 2) CATEGORIES
-- Purpose: classifies projects (e.g., Tech, Art, Charity).
-- Key design:
--  - category_id is the Primary Key.
--  - category_name is UNIQUE so the same category is not duplicated.
-- ---------------------------
CREATE TABLE categories (
    category_id     BIGINT GENERATED ALWAYS AS IDENTITY PRIMARY KEY,
    category_name   VARCHAR(20) NOT NULL UNIQUE,
    description     TEXT,
    created_at      TIMESTAMP NOT NULL DEFAULT NOW()
);

COMMENT ON TABLE categories IS 'Project categories for browsing/filtering.';
COMMENT ON COLUMN categories.category_id IS 'Primary key for categories.';
COMMENT ON COLUMN categories.category_name IS 'Short category label. UNIQUE prevents duplicates.';
COMMENT ON COLUMN categories.description IS 'Optional explanation of the category.';
COMMENT ON COLUMN categories.created_at IS 'Timestamp when category was created.';


-- ---------------------------
-- 3) PROJECTS
-- Purpose: fundraising campaigns created by users.
-- Key design:
--  - project_id is PK.
--  - user_id FK -> users(users_id): project owner/creator.
--  - category_id FK -> categories(category_id).
-- Constraints:
--  - goal_amount must be positive.
--  - end_date must be after start_date.
-- ---------------------------
CREATE TABLE projects (
    project_id      BIGINT GENERATED ALWAYS AS IDENTITY PRIMARY KEY,
    user_id         BIGINT NOT NULL,
    category_id     BIGINT NOT NULL,
    description     TEXT NOT NULL,
    goal_amount     NUMERIC(10,2) NOT NULL CHECK (goal_amount > 0),
    start_date      TIMESTAMP NOT NULL,
    end_date        TIMESTAMP NOT NULL,
    created_at      TIMESTAMP NOT NULL DEFAULT NOW(),
    updated_at      TIMESTAMP NOT NULL DEFAULT NOW(),
    CONSTRAINT chk_project_dates CHECK (end_date > start_date),
    CONSTRAINT fk_projects_user
        FOREIGN KEY (user_id) REFERENCES users(users_id)
        ON DELETE RESTRICT ON UPDATE CASCADE,
    CONSTRAINT fk_projects_category
        FOREIGN KEY (category_id) REFERENCES categories(category_id)
        ON DELETE RESTRICT ON UPDATE CASCADE
);

COMMENT ON TABLE projects IS 'Crowdfunding campaigns. Owned by a user and categorized.';
COMMENT ON COLUMN projects.project_id IS 'Primary key for projects.';
COMMENT ON COLUMN projects.user_id IS 'FK to users. Identifies project creator/owner.';
COMMENT ON COLUMN projects.category_id IS 'FK to categories. Used for filtering/browsing.';
COMMENT ON COLUMN projects.description IS 'Project text description shown to users.';
COMMENT ON COLUMN projects.goal_amount IS 'Target amount to raise. CHECK enforces > 0.';
COMMENT ON COLUMN projects.start_date IS 'Funding start timestamp.';
COMMENT ON COLUMN projects.end_date IS 'Funding end timestamp. Must be after start_date.';
COMMENT ON COLUMN projects.created_at IS 'Created timestamp (default NOW()).';
COMMENT ON COLUMN projects.updated_at IS 'Last update timestamp (default NOW()).';
COMMENT ON CONSTRAINT chk_project_dates ON projects IS 'Ensures end_date is after start_date.';
COMMENT ON CONSTRAINT fk_projects_user ON projects IS 'Links each project to exactly one owner (users).';
COMMENT ON CONSTRAINT fk_projects_category ON projects IS 'Links each project to exactly one category.';


-- ---------------------------
-- 4) REWARDS
-- Purpose: reward tiers for a project (e.g., sticker, T-shirt).
-- Key design:
--  - reward_id is PK.
--  - project_id FK -> projects(project_id).
-- Notes:
--  - reward_type can be used to classify (digital/physical/experience).
-- ---------------------------
CREATE TABLE rewards (
    reward_id       BIGINT GENERATED ALWAYS AS IDENTITY PRIMARY KEY,
    project_id      BIGINT NOT NULL,
    reward_name     VARCHAR(50) NOT NULL,
    description     TEXT,
    reward_type     VARCHAR(50),
    created_at      TIMESTAMP NOT NULL DEFAULT NOW(),
    updated_at      TIMESTAMP NOT NULL DEFAULT NOW(),
    CONSTRAINT fk_rewards_project
        FOREIGN KEY (project_id) REFERENCES projects(project_id)
        ON DELETE CASCADE ON UPDATE CASCADE
);

COMMENT ON TABLE rewards IS 'Reward tiers offered by a project. One project can have many rewards.';
COMMENT ON COLUMN rewards.reward_id IS 'Primary key for rewards.';
COMMENT ON COLUMN rewards.project_id IS 'FK to projects. Each reward belongs to one project.';
COMMENT ON COLUMN rewards.reward_name IS 'Short title for the reward tier.';
COMMENT ON COLUMN rewards.description IS 'Details of what donor receives.';
COMMENT ON COLUMN rewards.reward_type IS 'Classification of reward (e.g., physical/digital/experience).';
COMMENT ON COLUMN rewards.created_at IS 'Created timestamp.';
COMMENT ON COLUMN rewards.updated_at IS 'Updated timestamp.';
COMMENT ON CONSTRAINT fk_rewards_project ON rewards IS 'If a project is deleted, its rewards are deleted (CASCADE).';


-- ---------------------------
-- 5) PAYMENT_METHODS
-- Purpose: supported ways to pay (e.g., card, Kaspi, PayPal).
-- Key design:
--  - method_id is PK.
-- Constraints:
--  - transaction_fee must be >= 0.
--  - active indicates if method can currently be used.
-- ---------------------------
CREATE TABLE payment_methods (
    method_id        BIGINT GENERATED ALWAYS AS IDENTITY PRIMARY KEY,
    name             VARCHAR(100) NOT NULL UNIQUE,
    amount           NUMERIC(10,2),
    description      TEXT,
    active           BOOLEAN NOT NULL DEFAULT TRUE,
    transaction_fee  NUMERIC(10,2) NOT NULL DEFAULT 0 CHECK (transaction_fee >= 0)
);

COMMENT ON TABLE payment_methods IS 'Supported payment rails. Used by donations.';
COMMENT ON COLUMN payment_methods.method_id IS 'Primary key for payment methods.';
COMMENT ON COLUMN payment_methods.name IS 'Method name (UNIQUE), e.g., Card, Kaspi QR.';
COMMENT ON COLUMN payment_methods.amount IS 'Optional field from ERD (can represent a fixed fee/min amount).';
COMMENT ON COLUMN payment_methods.description IS 'Extra details/instructions about this method.';
COMMENT ON COLUMN payment_methods.active IS 'If FALSE, method cannot be used for new donations.';
COMMENT ON COLUMN payment_methods.transaction_fee IS 'Fee charged for processing. CHECK ensures non-negative.';


-- ---------------------------
-- 6) DONATIONS
-- Purpose: records each donation/payment attempt.
-- Key design:
--  - donation_id is PK.
--  - users_id FK -> users(users_id): who donated
--  - project_id FK -> projects(project_id): to which project
--  - method_id FK -> payment_methods(method_id): how they paid
-- Constraints:
--  - amount must be positive
--  - status limited to allowed values
-- ---------------------------
CREATE TABLE donations (
    donation_id      BIGINT GENERATED ALWAYS AS IDENTITY PRIMARY KEY,
    donation_type    VARCHAR(20),
    users_id         BIGINT NOT NULL,
    project_id       BIGINT NOT NULL,
    method_id        BIGINT NOT NULL,
    amount           NUMERIC(10,2) NOT NULL CHECK (amount > 0),
    donation_date    TIMESTAMP NOT NULL DEFAULT NOW(),
    status           VARCHAR(20) NOT NULL DEFAULT 'pending'
        CHECK (status IN ('pending','paid','failed','refunded')),
    CONSTRAINT fk_donations_user
        FOREIGN KEY (users_id) REFERENCES users(users_id)
        ON DELETE RESTRICT ON UPDATE CASCADE,
    CONSTRAINT fk_donations_project
        FOREIGN KEY (project_id) REFERENCES projects(project_id)
        ON DELETE CASCADE ON UPDATE CASCADE,
    CONSTRAINT fk_donations_method
        FOREIGN KEY (method_id) REFERENCES payment_methods(method_id)
        ON DELETE RESTRICT ON UPDATE CASCADE
);

COMMENT ON TABLE donations IS 'Donation/payment records. Links donor, project, and payment method.';
COMMENT ON COLUMN donations.donation_id IS 'Primary key for each donation record.';
COMMENT ON COLUMN donations.donation_type IS 'Optional type label (e.g., one-time, anonymous, recurring).';
COMMENT ON COLUMN donations.users_id IS 'FK to users: donor who paid.';
COMMENT ON COLUMN donations.project_id IS 'FK to projects: campaign receiving funds.';
COMMENT ON COLUMN donations.method_id IS 'FK to payment_methods: how it was paid.';
COMMENT ON COLUMN donations.amount IS 'Donation amount. Must be > 0.';
COMMENT ON COLUMN donations.donation_date IS 'Timestamp of donation creation.';
COMMENT ON COLUMN donations.status IS 'Payment status with CHECK constraint.';
COMMENT ON CONSTRAINT fk_donations_user ON donations IS 'One user can make many donations (1:M).';
COMMENT ON CONSTRAINT fk_donations_project ON donations IS 'One project can receive many donations (1:M). CASCADE deletes donations if project deleted.';
COMMENT ON CONSTRAINT fk_donations_method ON donations IS 'One method can be used for many donations (1:M).';


-- ---------------------------
-- 7) COMMENTS
-- Purpose: user messages under a project for engagement/trust.
-- Key design:
--  - comment_id is PK.
--  - project_id FK -> projects(project_id)
--  - user_id FK -> users(users_id)
-- ---------------------------
CREATE TABLE comments (
    comment_id      BIGINT GENERATED ALWAYS AS IDENTITY PRIMARY KEY,
    project_id      BIGINT NOT NULL,
    user_id         BIGINT NOT NULL,
    description     TEXT NOT NULL,
    created_at      TIMESTAMP NOT NULL DEFAULT NOW(),
    updated_at      TIMESTAMP NOT NULL DEFAULT NOW(),
    CONSTRAINT fk_comments_project
        FOREIGN KEY (project_id) REFERENCES projects(project_id)
        ON DELETE CASCADE ON UPDATE CASCADE,
    CONSTRAINT fk_comments_user
        FOREIGN KEY (user_id) REFERENCES users(users_id)
        ON DELETE RESTRICT ON UPDATE CASCADE
);

COMMENT ON TABLE comments IS 'Comments posted by users on projects.';
COMMENT ON COLUMN comments.comment_id IS 'Primary key for comment.';
COMMENT ON COLUMN comments.project_id IS 'FK to projects: which project the comment belongs to.';
COMMENT ON COLUMN comments.user_id IS 'FK to users: who posted the comment.';
COMMENT ON COLUMN comments.description IS 'Comment text.';
COMMENT ON COLUMN comments.created_at IS 'Comment creation timestamp.';
COMMENT ON COLUMN comments.updated_at IS 'Last edit timestamp.';
COMMENT ON CONSTRAINT fk_comments_project ON comments IS 'One project has many comments. CASCADE on project deletion.';
COMMENT ON CONSTRAINT fk_comments_user ON comments IS 'One user has many comments. Prevent deleting user if comments exist (RESTRICT).';


-- Helpful indexes for common queries (optional but practical)
CREATE INDEX idx_projects_category ON projects(category_id);
CREATE INDEX idx_projects_user ON projects(user_id);
CREATE INDEX idx_donations_project ON donations(project_id);
CREATE INDEX idx_donations_user ON donations(users_id);
CREATE INDEX idx_comments_project ON comments(project_id);
6) Why each Primary Key / Foreign Key was defined (quick explanation)
Primary Keys (users_id, project_id, etc.) uniquely identify rows and allow stable references from other tables.

Foreign Keys enforce real relationships:

